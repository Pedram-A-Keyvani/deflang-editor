{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "def-lang",
  "scopeName": "source.def",
  "patterns": [
    {
      "include": "#entry"
    },
    {
      "include": "#python-def"
    },
    {
      "include": "#html-def"
    },
    {
      "include": "#css-def"
    },
    {
      "include": "#javascript-def"
    },
    {
      "include": "#js-def"
    },
    {
      "include": "#sql-def"
    },
    {
      "include": "#markdown-def"
    },
    {
      "include": "#json-def"
    },
    {
      "include": "#shell-def"
