    "sql-def": {
      "name": "meta.def.sql.def",
      "begin": "^((?:(?:internal|shared)\\s+)*)(sql)(\\[[^\\]]*\\])?\\s+(.*)$",
      "beginCaptures": {
        "1": {
          "patterns": [
            {
              "include": "#modifiers"
            }
          ]
        },
        "2": {
          "name": "storage.type.def.def"
        },
        "3": {
          "patterns": [
            {
              "include": "#flags"
            }
          ]
        },
        "4": {
          "patterns": [
            {
              "include": "#pattern"
            }
          ]
        }
