    "js-def": {
      "name": "meta.def.js.def",
      "begin": "^((?:(?:internal|shared)\\s+)*)(js)(\\[[^\\]]*\\])?\\s+(.*)$",
      "beginCaptures": {
        "1": {
          "patterns": [
            {
