    {
      "include": "#bash-def"
    },
    {
      "include": "#yaml-def"
    },
    {
      "include": "#def"
    },
    {
      "include": "#statement"
    },
    {
      "include": "#means"
    },
    {
      "include": "#echo"
    },
    {
      "include": "#expression"
    }
  ],
  "repository": {
    "entry": {
      "name": "meta.entry.def",
      "begin": "^(language|flag|modifier|statement)\\s+([\\w-]+)\\s*$",
      "beginCaptures": {
        "1": {
          "name": "storage.type.def.def"
        },
        "2": {
          "name": "entity.name.type.def"
        }
      },
      "end": "^(?=\\S)",
      "patterns": [
        {
          "begin": "^([ \\t]+)(does)\\s*$",
          "beginCaptures": {
            "2": {
              "name": "keyword.control.field.def"
            }
          },
          "end": "^(?!\\1[ \\t]+\\S)(?=[ \\t]*\\S)",
          "contentName": "meta.embedded.block.python",
          "patterns": [
            {
              "include": "source.python"
            }
          ]
        },
        {
          "match": "^[ \\t]+(words)\\s+(.*)$",
          "captures": {
            "1": {
              "name": "keyword.control.field.def"
            },
            "2": {
              "patterns": [
                {
                  "include": "#pattern"
                }
              ]
            }
          }
        },
        {
          "match": "^[ \\t]+(applies\\s+to)\\s+(.*)$",
          "captures": {
            "1": {
              "name": "keyword.control.field.def"
            },
            "2": {
              "name": "constant.language.def"
            }
          }
        },
        {
          "match": "^[ \\t]+(replaces)\\s+(.*)$",
          "captures": {
            "1": {
              "name": "keyword.control.field.def"
            },
            "2": {
              "name": "entity.name.namespace.def"
            }
          }
        },
        {
          "match": "^[ \\t]+(flags|editor|takes)\\s+(.*)$",
          "captures": {
            "1": {
              "name": "keyword.control.field.def"
            },
            "2": {
              "patterns": [
                {
                  "include": "#flags"
                }
              ]
            }
          }
        }
      ]
    },
    "python-def": {
      "name": "meta.def.python.def",
      "begin": "^((?:(?:internal|shared)\\s+)*)(python)(\\[[^\\]]*\\])?\\s+(.*)$",
      "beginCaptures": {
        "1": {
          "patterns": [
            {
              "include": "#modifiers"
            }
          ]
        },
        "2": {
          "name": "storage.type.def.def"
        },
        "3": {
          "patterns": [
            {
              "include": "#flags"
            }
          ]
        },
        "4": {
          "patterns": [
            {
              "include": "#pattern"
            }
          ]
        }
      },
      "end": "^(?=\\S)",
      "patterns": [
        {
          "name": "meta.embedded.block.python",
          "begin": "^(?=[ \\t])",
          "end": "^(?=\\S)",
          "patterns": [
            {
              "include": "source.python"
            }
          ]
        }
      ]
    },
    "html-def": {
      "name": "meta.def.html.def",
      "begin": "^((?:(?:internal|shared)\\s+)*)(html)(\\[[^\\]]*\\])?\\s+(.*)$",
      "beginCaptures": {
        "1": {
          "patterns": [
            {
              "include": "#modifiers"
            }
          ]
        },
        "2": {
          "name": "storage.type.def.def"
        },
        "3": {
