    "yaml-def": {
      "name": "meta.def.yaml.def",
      "begin": "^((?:(?:internal|shared)\\s+)*)(yaml)(\\[[^\\]]*\\])?\\s+(.*)$",
      "beginCaptures": {
        "1": {
          "patterns": [
            {
              "include": "#modifiers"
            }
          ]
        },
        "2": {
          "name": "storage.type.def.def"
        },
        "3": {
          "patterns": [
            {
              "include": "#flags"
            }
          ]
        },
        "4": {
          "patterns": [
            {
              "include": "#pattern"
            }
