    },
    "javascript-def": {
      "name": "meta.def.javascript.def",
      "begin": "^((?:(?:internal|shared)\\s+)*)(javascript)(\\[[^\\]]*\\])?\\s+(.*)$",
      "beginCaptures": {
        "1": {
          "patterns": [
