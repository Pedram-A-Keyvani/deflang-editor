            }
          ]
        }
      ]
    },
    "def": {
      "match": "^((?:(?:internal|shared)\\s+)*)(def)(\\[[^\\]]*\\])?\\s+(.*)$",
      "captures": {
        "1": {
          "patterns": [
            {
              "include": "#modifiers"
            }
          ]
        },
        "2": {
          "name": "storage.type.def.def"
        },
        "3": {
          "patterns": [
            {
              "include": "#flags"
            }
          ]
        },
        "4": {
          "patterns": [
            {
              "include": "#pattern"
            }
          ]
        }
      }
    },
    "modifiers": {
      "patterns": [
        {
          "name": "keyword.control.def",
          "match": "[\\w-]+"
        }
      ]
    },
    "flags": {
      "patterns": [
        {
          "name": "punctuation.section.brackets.def",
          "match": "[\\[\\],]"
        },
        {
          "name": "storage.modifier.as-written.def",
          "match": "\\bwritten\\b"
        },
        {
          "name": "constant.numeric.def",
          "match": "(?<![\\w.])\\d+(?:\\.\\d+)?\\b"
        },
        {
          "name": "storage.modifier.def",
          "match": "[\\w-]+"
        }
      ]
    },
    "pattern": {
      "patterns": [
        {
          "match": "(\\()(A\\d+)(:)\\s*(.*)(\\))",
          "captures": {
            "1": {
              "name": "punctuation.definition.parameter.def"
            },
            "2": {
              "name": "variable.parameter.def"
            },
            "3": {
              "name": "punctuation.separator.def"
            },
            "4": {
              "name": "string.regexp.def"
            },
            "5": {
              "name": "punctuation.definition.parameter.def"
            }
          }
        },
        {
          "name": "variable.parameter.def",
          "match": "\\bA\\d+\\b"
        },
        {
          "name": "keyword.operator.def",
          "match": "[^\\w\\s]+"
        },
        {
          "name": "entity.name.function.def",
          "match": "[\\w.]+"
        }
      ]
    },
    "statement": {
      "patterns": [
        {
          "match": "^(use)\\s+(?:(.+?)\\s+(from)\\s+)?(\\S+)\\s*$",
          "captures": {
            "1": {
              "name": "keyword.control.import.def"
            },
            "2": {
              "name": "variable.other.def"
            },
            "3": {
              "name": "keyword.control.import.def"
            },
            "4": {
              "name": "entity.name.namespace.def"
            }
          }
        },
        {
          "match": "^(argument|comment)\\s+(is)\\s+(.*)$",
          "captures": {
            "1": {
              "name": "keyword.control.def"
            },
            "2": {
              "name": "keyword.control.def"
            },
            "3": {
              "name": "variable.parameter.def"
            }
          }
        },
        {
          "match": "^\\s*(shared)\\s+(\\w+)",
          "captures": {
            "1": {
              "name": "keyword.control.def"
            },
            "2": {
              "name": "variable.other.def"
            }
          }
        },
        {
          "match": "^(indent)\\s+(\\d+)\\s*$",
          "captures": {
            "1": {
              "name": "keyword.control.def"
            },
            "2": {
              "name": "constant.numeric.def"
            }
          }
        },
        {
          "match": "^\\s*(error)\\s+(.*)$",
          "captures": {
            "1": {
              "name": "keyword.control.error.def"
            },
            "2": {
              "name": "invalid.illegal.message.def"
            }
          }
        }
      ]
    },
    "means": {
      "match": "^(?!def[\\s\\[]|use\\s|comment\\s|argument\\s|error\\s)(\\S.*?)\\s+(means)\\s+(.*)$",
      "captures": {
        "1": {
          "name": "entity.name.function.def"
        },
        "2": {
          "name": "keyword.control.means.def"
        },
        "3": {
          "patterns": [
            {
              "include": "#expression"
            }
          ]
        }
      }
    },
    "echo": {
      "name": "meta.echo.def",
      "begin": "^\\s*(`)",
      "end": "(`)\\s*$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.echo.def"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.echo.def"
        }
      },
      "patterns": [
        {
          "include": "#expression"
        }
      ]
    },
    "expression": {
      "patterns": [
        {
          "name": "string.quoted.double.def",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.def"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.def"
            }
          }
        },
        {
          "name": "variable.parameter.def",
          "match": "\\bA\\d+\\b"
        },
        {
          "name": "keyword.control.question.def",
          "match": "\\?"
        },
        {
          "name": "keyword.control.loop.def",
          "match": "\\b(?:repeat|times|while|for\\s+each|in|if|otherwise)\\b"
        },
        {
          "name": "keyword.other.operator.def",
          "match": "\\b(?:is\\s+greater\\s+than\\s+or\\s+equal\\s+to|greater\\s+than\\s+or\\s+equal\\s+to|is\\s+less\\s+than\\s+or\\s+equal\\s+to|less\\s+than\\s+or\\s+equal\\s+to|is\\s+greater\\s+than|multiplied\\s+by|greater\\s+than|is\\s+less\\s+than|is\\s+equal\\s+to|divided\\s+by|less\\s+than|equal\\s+to|minus|plus)\\b"
        },
        {
          "name": "keyword.other.logical.def",
          "match": "\\b(?:both|and|either|or|not)\\b"
        },
        {
          "name": "keyword.control.means.def",
          "match": "\\b(?:means)\\b"
        },
        {
          "name": "keyword.other.shared.def",
          "match": "^\\s*shared(?=\\s)"
        },
        {
          "name": "keyword.other.def",
          "match": "\\b(?:is\\s+not|is|are|does|do)\\b"
        },
        {
          "name": "constant.numeric.def",
          "match": "(?<![\\w.])[+-]?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.word.def",
          "match": "\\b(?:zero|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen|twenty|thirty|forty|fifty|sixty|seventy|eighty|ninety|hundred|thousand|million|billion)\\b"
        },
        {
          "name": "constant.language.def",
          "match": "\\b(?:True|False|None)\\b"
        },
        {
          "name": "keyword.operator.def",
          "match": ">=|<=|[<>=+\\-*/#:]"
        },
        {
          "name": "punctuation.section.brackets.def",
          "match": "[\\[\\],]"
        }
      ]
    }
  }
}
