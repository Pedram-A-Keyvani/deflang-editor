{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "def-lang",
  "scopeName": "source.def",
  "patterns": [
    {
      "include": "#entry"
    },
    {
      "include": "#language-0"
    },
    {
      "include": "#use"
    },
    {
      "include": "#expression"
    }
  ],
  "repository": {
    "language-0": {
      "name": "meta.def.python.def",
      "begin": "^()(python)(\\[[^\\]]*\\])?\\s+(.*)$",
      "beginCaptures": {
        "1": {
          "patterns": [
            {
              "include": "#modifiers"
            }
          ]
        },
        "2": {
          "name": "storage.type.def.def"
        },
        "3": {
          "patterns": [
            {
              "include": "#flags"
            }
          ]
        },
        "4": {
          "patterns": [
            {
              "include": "#pattern"
            }
          ]
        }
      },
      "end": "^(?=\\S)",
      "patterns": [
        {
          "name": "meta.embedded.block.python",
          "begin": "^(?=[ \\t])",
          "end": "^(?=\\S)",
          "patterns": [
            {
              "include": "source.python"
            }
          ]
        }
      ]
    },
    "entry": {
      "name": "meta.entry.def",
      "begin": "^(language|flag|modifier|statement)\\s+([\\w-]+)\\s*$",
      "beginCaptures": {
        "1": {
          "name": "storage.type.def.def"
        },
        "2": {
          "name": "entity.name.type.def"
        }
      },
      "end": "^(?=\\S)",
      "patterns": [
        {
          "begin": "^([ \\t]+)(does)\\s+(in)\\s+(python)(\\[[^\\]]*\\])?\\s*$",
          "beginCaptures": {
            "2": {
              "name": "keyword.control.field.def"
            },
            "3": {
              "name": "keyword.control.field.def"
            },
            "4": {
              "name": "storage.type.def.def"
            },
            "5": {
              "patterns": [
                {
                  "include": "#flags"
                }
              ]
            }
          },
          "end": "^(?!\\1[ \\t]+\\S)(?=[ \\t]*\\S)",
          "contentName": "meta.embedded.block.python",
          "patterns": [
            {
              "include": "source.python"
            }
          ]
        },
        {
          "match": "^[ \\t]+(does)\\s+(in)\\s+(\\w+)(\\[[^\\]]*\\])?\\s*$",
          "captures": {
            "1": {
              "name": "keyword.control.field.def"
            },
            "2": {
              "name": "keyword.control.field.def"
            },
            "3": {
              "name": "storage.type.def.def"
            },
            "4": {
              "patterns": [
                {
                  "include": "#flags"
                }
              ]
            }
          }
        },
        {
          "match": "^[ \\t]+(words)\\s+(.*)$",
          "captures": {
            "1": {
              "name": "keyword.control.field.def"
            },
            "2": {
              "patterns": [
                {
                  "include": "#pattern"
                }
              ]
            }
          }
        },
        {
          "match": "^[ \\t]+(replaces)\\s+(.*)$",
          "captures": {
            "1": {
              "name": "keyword.control.field.def"
            },
            "2": {
              "name": "entity.name.namespace.def"
            }
          }
        },
        {
          "match": "^[ \\t]+(editor)\\s+(.*)$",
          "captures": {
            "1": {
              "name": "keyword.control.field.def"
            },
            "2": {
              "patterns": [
                {
                  "include": "#flags"
                }
              ]
            }
          }
        }
      ]
    },
    "modifiers": {
      "patterns": [
        {
          "name": "keyword.control.def",
          "match": "[\\w-]+"
        }
      ]
    },
    "flags": {
      "patterns": [
        {
          "name": "punctuation.section.brackets.def",
          "match": "[\\[\\],]"
        },
        {
          "name": "constant.numeric.def",
          "match": "(?<![\\w.])\\d+(?:\\.\\d+)?\\b"
        },
        {
          "name": "storage.modifier.def",
          "match": "[\\w-]+"
        }
      ]
    },
    "pattern": {
      "patterns": [
        {
          "match": "(\\()([A-Z]\\w*?\\d+)(:)\\s*(.*)(\\))",
          "captures": {
            "1": {
              "name": "punctuation.definition.parameter.def"
            },
            "2": {
              "name": "variable.parameter.def"
            },
            "3": {
              "name": "punctuation.separator.def"
            },
            "4": {
              "name": "string.regexp.def"
            },
            "5": {
              "name": "punctuation.definition.parameter.def"
            }
          }
        },
        {
          "name": "variable.parameter.def",
          "match": "\\b[A-Z]\\d+\\b"
        },
        {
          "name": "keyword.operator.def",
          "match": "[^\\w\\s]+"
        },
        {
          "name": "entity.name.function.def",
          "match": "[\\w.]+"
        }
      ]
    },
    "use": {
      "match": "^(use)\\s+(?:(.+?)\\s+(from)\\s+)?(\\S+)\\s*$",
      "captures": {
        "1": {
          "name": "keyword.control.import.def"
        },
        "2": {
          "name": "variable.other.def"
        },
        "3": {
          "name": "keyword.control.import.def"
        },
        "4": {
          "name": "entity.name.namespace.def"
        }
      }
    },
    "expression": {
      "patterns": [
        {
          "name": "string.quoted.double.def",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.def"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.def"
            }
          }
        },
        {
          "name": "variable.parameter.def",
          "match": "\\b[A-Z]\\d+\\b"
        },
        {
          "name": "constant.numeric.def",
          "match": "(?<![\\w.])[+-]?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.language.def",
          "match": "\\b(?:True|False|None)\\b"
        },
        {
          "name": "keyword.operator.def",
          "match": ">=|<=|[<>=+\\-*/#:?`]"
        },
        {
          "name": "punctuation.section.brackets.def",
          "match": "[\\[\\],]"
        }
      ]
    }
  }
}
