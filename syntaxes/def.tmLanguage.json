    "markdown-def": {
      "name": "meta.def.markdown.def",
      "begin": "^((?:(?:internal|shared)\\s+)*)(markdown)(\\[[^\\]]*\\])?\\s+(.*)$",
      "beginCaptures": {
        "1": {
          "patterns": [
            {
              "include": "#modifiers"
            }
          ]
        },
        "2": {
