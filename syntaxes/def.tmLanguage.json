    "bash-def": {
      "name": "meta.def.bash.def",
      "begin": "^((?:(?:internal|shared)\\s+)*)(bash)(\\[[^\\]]*\\])?\\s+(.*)$",
      "beginCaptures": {
        "1": {
          "patterns": [
            {
              "include": "#modifiers"
            }
          ]
        },
        "2": {
          "name": "storage.type.def.def"
        },
        "3": {
