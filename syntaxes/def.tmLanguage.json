    },
    "json-def": {
      "name": "meta.def.json.def",
      "begin": "^((?:(?:internal|shared)\\s+)*)(json)(\\[[^\\]]*\\])?\\s+(.*)$",
      "beginCaptures": {
        "1": {
          "patterns": [
