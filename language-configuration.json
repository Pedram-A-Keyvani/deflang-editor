{
  "comments": { "lineComment": "//" },
  "brackets": [["[", "]"]],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "`", "close": "`", "notIn": ["string"] }
  ],
  "surroundingPairs": [["\"", "\""], ["[", "]"], ["`", "`"]],
  "onEnterRules": [
    { "beforeText": "^\\s*def\\s.*$", "action": { "indent": "indent" } },
    { "beforeText": "^.*\\?\\s*$", "action": { "indent": "indent" } }
  ]
}
